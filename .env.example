# ---------------------------------------------------------------------------
# Copy this file to `.env` and fill in the values you have.
#
# You need ONE text-provider key to run at all, and (optionally) a vision key
# to switch on the photo-to-business-plan flow. Everything else degrades to a
# free fallback or a clearly-labelled simulated adapter.
# ---------------------------------------------------------------------------

# === 1. TEXT PROVIDER (required) ===========================================
# Which provider runs the supervisor and the seven text agents.
#   groq       — fast, generous free tier, NO vision model    (default)
#   anthropic  — best quality + vision, paid
#   google     — good quality + vision, generous free tier
AIW_PROVIDER=groq

# Supply the key for whichever provider you chose above.
GROQ_API_KEY=gsk_...
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=

# Optional model overrides. Blank = a sensible default for the provider.
#   groq      -> openai/gpt-oss-120b  +  llama-3.3-70b-versatile (routing)
#   anthropic -> claude-opus-5        +  claude-haiku-4-5
#   google    -> gemini-2.0-flash     +  gemini-2.0-flash-lite
AIW_MODEL=
AIW_FAST_MODEL=
AIW_EFFORT=high                # Anthropic only: low | medium | high | xhigh | max

# === 2. PHOTO UNDERSTANDING (optional but recommended) =====================
# Groq currently serves no multimodal model, so with AIW_PROVIDER=groq the
# Product Vision agent cannot read photos and will say so instead of guessing.
# Adding a FREE Google AI Studio key (aistudio.google.com/apikey) switches the
# photo flow back on — no other change needed.
#
# Leave blank to auto-pick: uses the text provider if it is multimodal,
# otherwise whichever of google / anthropic has a key.
AIW_VISION_PROVIDER=
AIW_VISION_MODEL=

# === 3. TOOLS (all optional) ===============================================

# Real web search. Without it, search falls back to DuckDuckGo (free, no key),
# and without that to a labelled simulated adapter.
TAVILY_API_KEY=

# Meta Graph API (Facebook Page + Instagram Business). Business verification is
# not obtainable inside a student project timeline, so leaving these blank
# activates the SIMULATED publishing adapter.
META_ACCESS_TOKEN=
META_PAGE_ID=
META_IG_USER_ID=

# YouTube Data API v3 (uploads need OAuth consent, so publishing stays simulated)
YOUTUBE_API_KEY=

# Courier providers. Blank => SIMULATED courier adapter.
PATHAO_CLIENT_ID=
PATHAO_CLIENT_SECRET=
STEADFAST_API_KEY=
STEADFAST_SECRET_KEY=

# === 4. ACCOUNTS / SESSIONS ================================================
# Signs the session cookie. Leave blank locally and one is generated on each
# start — which signs everyone out whenever the server restarts. Set a long
# random value (e.g. `python -c "import secrets;print(secrets.token_hex(32))"`)
# for anything you keep running.
AIW_SECRET_KEY=

# Set to 1 when serving over HTTPS so the session cookie is never sent in
# clear. Leave blank for local http://127.0.0.1.
AIW_HTTPS=

# --- Verification email (optional) -----------------------------------------
# Sends the six-digit sign-up code. Leave blank and the code is shown on the
# verify screen instead, clearly labelled as not emailed.
#
# For Gmail you need an App Password, NOT your normal password:
#   1. Turn on 2-Step Verification: https://myaccount.google.com/security
#   2. Create one at https://myaccount.google.com/apppasswords
#   3. Paste the 16-character value below (spaces are fine to remove)
AIW_SMTP_HOST=smtp.gmail.com
AIW_SMTP_PORT=587
AIW_SMTP_USER=
AIW_SMTP_PASSWORD=
AIW_SMTP_FROM=

# --- Sign in with Google (optional) ----------------------------------------
# Blank = the Google button is hidden rather than shown and broken.
#   1. https://console.cloud.google.com/ → create or pick a project
#   2. APIs & Services → OAuth consent screen → External → fill in the basics
#   3. Credentials → Create credentials → OAuth client ID → Web application
#   4. Authorised redirect URI must match AIW_GOOGLE_REDIRECT_URI exactly
AIW_GOOGLE_CLIENT_ID=
AIW_GOOGLE_CLIENT_SECRET=
AIW_GOOGLE_REDIRECT_URI=http://127.0.0.1:8000/auth/google/callback

# === 5. DATABASE (optional) ================================================
# Blank = a local SQLite file in data/. No account, no network, works offline
# — this is the default and is genuinely free.
#
# To keep the shop's memory off this machine (so both front-ends, or two
# deployments, share one brain), point these at a free Turso database:
#
#   1. https://turso.tech  → sign up (free tier: 500 DBs, 9 GB)
#   2. turso db create lucida
#   3. turso db show lucida --url        → AIW_DATABASE_URL
#   4. turso db tokens create lucida     → AIW_DATABASE_AUTH_TOKEN
#
# libSQL speaks SQLite's dialect, so the schema and every query are unchanged.
AIW_DATABASE_URL=
AIW_DATABASE_AUTH_TOKEN=

# === 6. BUSINESS DEFAULTS ==================================================
AIW_DEFAULT_CURRENCY=BDT
AIW_DEFAULT_LOCATION=Dhaka, Bangladesh

# --- YouTube uploads (optional) --------------------------------------------
# YOUTUBE_API_KEY only *reads*. Publishing a video happens as the channel
# owner, so it needs OAuth2 — get these from the same Google Cloud project as
# the sign-in credentials, with the YouTube Data API v3 enabled:
#   1. Credentials → OAuth client ID → Desktop app
#   2. Authorise the scope https://www.googleapis.com/auth/youtube.upload
#   3. Exchange the one-time code for a refresh token and paste it below
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=
