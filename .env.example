# ---------------------------------------------------------------------------
# Copy this file to `.env` and fill in the values you have.
# Only ANTHROPIC_API_KEY is strictly required; everything else degrades
# gracefully to a clearly-labelled simulated adapter or a free fallback.
# ---------------------------------------------------------------------------

# REQUIRED — powers every agent + the Product Vision agent's image understanding
ANTHROPIC_API_KEY=sk-ant-...

# Model selection (see src/aiworkforce/pricing.py for the supported IDs)
AIW_MODEL=claude-opus-5
AIW_FAST_MODEL=claude-haiku-4-5      # used for cheap classification-style calls
AIW_EFFORT=high                       # low | medium | high | xhigh | max

# OPTIONAL — real web search. Without it the system falls back to DuckDuckGo
# (no key needed), and without that to a labelled simulated search adapter.
TAVILY_API_KEY=

# OPTIONAL — Meta Graph API (Facebook Page + Instagram Business).
# Business verification is not obtainable inside a student project timeline,
# so leaving these blank activates the SIMULATED publishing adapter.
META_ACCESS_TOKEN=
META_PAGE_ID=
META_IG_USER_ID=

# OPTIONAL — YouTube Data API v3
YOUTUBE_API_KEY=

# OPTIONAL — courier providers. Blank => SIMULATED courier adapter.
PATHAO_CLIENT_ID=
PATHAO_CLIENT_SECRET=
STEADFAST_API_KEY=
STEADFAST_SECRET_KEY=

# Business defaults used when the owner has not set a profile yet
AIW_DEFAULT_CURRENCY=BDT
AIW_DEFAULT_LOCATION=Dhaka, Bangladesh
