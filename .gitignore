__pycache__/
*.py[cod]
.venv/
venv/
env/
.env
.streamlit/secrets.toml

# Runtime state — regenerated on first run
# The key session cookies are signed with. Committing it would let anyone
# with the repository forge a signed-in session for any account.
data/session.key
data/*.key

data/lucida.db
data/checkpoints.db
data/checkpoints.db-shm
data/checkpoints.db-wal
data/vectors/
data/uploads/
!data/.gitkeep

# Owner accounts and their private shop data. Never commit these: accounts.db
# holds email addresses and password hashes, and each shop database is one
# business's real trading history.
data/accounts.db
data/accounts.db-*
data/shops/
data/avatars/

# Design bundle archive — the extracted files under web/design/ are what ship
Form selections needed.zip

# Local jsdom harness used to verify the design boots
node_modules/

*.log
.DS_Store
.idea/
.vscode/

# Never commit a copy of the environment, whatever it is called. `.env` alone
# was not enough: a `.env.backup` made while rotating keys is just as live.
.env.*
!.env.example
*.backup
*.bak

# Superseded database from the pre-Lucida package name
data/aiworkforce.db

# local .env backups
.env.bak-*
.env.bak

# The marksheet holds 23 students' names, IDs, grades and integrity flags.
# It is other people's personal data and must never reach a remote.
*MARKSHEET*.xlsx

# Build artefacts of the submission package, not sources of it.
Lucida_Submission_v2/
Lucida_Resubmission_*.zip
code_screenshots/
vscode_screenshots/

# Generated at runtime, not source.
data/paid_images.json
data/media/

# Raw editor captures. The 25-page evidence PDF carries all of them,
# so committing 10 MB of PNGs would only duplicate it in the history.
vscode_real/

# Built submission packages — regenerated by tools/make_submission.py
dist/
