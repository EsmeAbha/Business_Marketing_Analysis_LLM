__pycache__/
*.py[cod]
.venv/
venv/
env/
.env
.streamlit/secrets.toml

# Runtime state — regenerated on first run
# The key session cookies are signed with. Committing it would let anyone
# with the repository forge a signed-in session for any account.
data/session.key
data/*.key

data/lucida.db
data/checkpoints.db
data/checkpoints.db-shm
data/checkpoints.db-wal
data/vectors/
data/uploads/
!data/.gitkeep

# Owner accounts and their private shop data. Never commit these: accounts.db
# holds email addresses and password hashes, and each shop database is one
# business's real trading history.
data/accounts.db
data/accounts.db-*
data/shops/
data/avatars/

# Design bundle archive — the extracted files under web/design/ are what ship
Form selections needed.zip

# Local jsdom harness used to verify the design boots
node_modules/

*.log
.DS_Store
.idea/
.vscode/

# Never commit a copy of the environment, whatever it is called. `.env` alone
# was not enough: a `.env.backup` made while rotating keys is just as live.
.env.*
!.env.example
*.backup
*.bak

# Superseded database from the pre-Lucida package name
data/aiworkforce.db

# local .env backups
.env.bak-*
.env.bak
